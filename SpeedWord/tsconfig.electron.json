{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "electron-dist",
    "rootDir": ".",
    "types": ["node"],
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "electron/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
